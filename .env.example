# =============================================================================
# Data Source Configuration
# =============================================================================
# Options: "mock" | "databricks"
# - mock:       uses synthetic in-memory data (great for demo and development)
# - databricks: reads the migrated tables from Unity Catalog via a SQL Warehouse
DATA_SOURCE=mock

# =============================================================================
# EMMA Reference Source (MFC / LRC factors)
# =============================================================================
# Options: "mock" | "excel" | "databricks". Defaults to DATA_SOURCE when unset.
# Set EMMA_SOURCE=excel to read the EMMA factors from local Excel workbooks
# while ADR comes from Databricks (the interim setup until the MFC/LRC tables
# land in Unity Catalog). Drop MFC.xlsx and LRC.xlsx into EMMA_DIR; the loader
# routes each file by its columns, not its name (a per-code factor file is
# treated as Material, a factorMultiplier + totalUSDRate file as Labor).
# EMMA_SOURCE=excel
EMMA_DIR=data

# =============================================================================
# Databricks (only used when DATA_SOURCE=databricks)
# =============================================================================
# Identity - resolved by databricks.sdk.core.Config (unified headless auth):
# - Inside Databricks Apps: NOTHING to set here. The platform injects
#   DATABRICKS_HOST + DATABRICKS_CLIENT_ID/SECRET (the app's service
#   principal) into the environment automatically.
# - Local development: set DATABRICKS_HOST + DATABRICKS_TOKEN (a personal
#   access token), or rely on a ~/.databrickscfg profile.
# There is NO browser-based auth path (the app must run headless).
# DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
# DATABRICKS_TOKEN=your-personal-access-token

# SQL Warehouse - one of the two. In Databricks Apps, attaching a
# "sql-warehouse" app resource injects DATABRICKS_WAREHOUSE_ID automatically;
# locally, copy the warehouse id (or the full HTTP path) from the warehouse's
# Connection details page.
# DATABRICKS_WAREHOUSE_ID=0000000000000000
# DATABRICKS_SQL_HTTP_PATH=/sql/1.0/warehouses/0000000000000000

# Unity Catalog namespace holding the migrated tables (table names match the
# Snowflake originals one-to-one). These are the in-code defaults - only set
# them if the tables move.
# DATABRICKS_CATALOG=entai_sandbox_catalog
# DATABRICKS_SCHEMA=data_quality_scorecards
