# =============================================================================
# Data Source Configuration
# =============================================================================
# Options: "mock" | "snowflake"
# - mock:      uses synthetic in-memory data (great for demo and development)
# - snowflake: connects to a real Snowflake account
DATA_SOURCE=mock

# =============================================================================
# EMMA Reference Source (MFC / LRC factors)
# =============================================================================
# Options: "mock" | "excel" | "snowflake". Defaults to DATA_SOURCE when unset.
# Set EMMA_SOURCE=excel to read the EMMA factors from local Excel workbooks
# while ADR still comes from Snowflake (the interim setup until the MFC/LRC
# tables land in Snowflake). Drop MFC.xlsx and LRC.xlsx into EMMA_DIR; the
# loader routes each file by its columns, not its name (a per-code factor file
# is treated as Material, a factorMultiplier + totalUSDRate file as Labor).
# EMMA_SOURCE=excel
EMMA_DIR=data

# =============================================================================
# Snowflake Connection (only used when DATA_SOURCE=snowflake)
# =============================================================================
# Placeholders only - never commit a real user / account / role to this file.
# Copy it to ``.env`` (which is gitignored) and fill in your credentials there.
SNOWFLAKE_ACCOUNT=YOUR-ACCOUNT
SNOWFLAKE_USER=your.user@example.com
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_WAREHOUSE=YOUR_WAREHOUSE
SNOWFLAKE_DATABASE=YOUR_DATABASE
SNOWFLAKE_SCHEMA=YOUR_SCHEMA
# SNOWFLAKE_ROLE=YOUR_ROLE

# =============================================================================
# Row Limits
# =============================================================================
# Maximum rows to load per table when "Sample mode" is on in the sidebar.
# Switch sample mode off in the sidebar to fetch the full dataset.
MAX_ROWS_PER_TABLE=50000
